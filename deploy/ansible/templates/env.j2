# Managed by Ansible — do not edit on the VM. Edit vars.yml / .secrets.yml and redeploy.
SANTA_IMAGE={{ santa_image }}
SANTA_TAG={{ santa_tag }}
APP_BIND={{ app_bind }}
APP_PORT={{ app_port }}

APP_URL={{ app_url }}
PORT=3000

# compose builds DATABASE_URL from POSTGRES_PASSWORD; keep in sync.
POSTGRES_PASSWORD={{ postgres_password }}
DATABASE_URL=postgres://santa:{{ postgres_password }}@postgres:5432/santa

ENCRYPTION_KEY={{ encryption_key }}

SMTP_HOST={{ smtp_host }}
SMTP_PORT={{ smtp_port }}
SMTP_USER={{ smtp_user | default('') }}
SMTP_PASSWORD={{ smtp_password | default('') }}
SMTP_SECURE={{ smtp_secure | lower }}
MAIL_FROM={{ mail_from }}

GROUP_CREATION={{ group_creation }}
GROUP_CREATION_ALLOWLIST={{ group_creation_allowlist }}
INSTANCE_ADMINS={{ instance_admins }}

INSTANCE_NAME={{ instance_name }}
DEFAULT_LANGUAGE={{ default_language }}
INACTIVE_GROUP_YEARS={{ inactive_group_years }}
TRUST_PROXY={{ trust_proxy | lower }}

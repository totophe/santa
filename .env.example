# ─── Santa configuration ──────────────────────────────────────────────────
# Copy to .env and fill in. See README for details.

# Public base URL, used in emails and QR codes (no trailing slash).
APP_URL=http://localhost:3000

# PostgreSQL connection string.
DATABASE_URL=postgres://santa:santa@localhost:5432/santa

# 32 bytes, base64-encoded. Encrypts draw assignments.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# WARNING: losing this key loses every draw and the no-repeat history. Back it up
# separately from the database.
ENCRYPTION_KEY=

# Outgoing mail (SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=Santa <santa@example.com>

# Web Push notifications (optional, like SMTP). Leave blank to disable.
# Generate a keypair once:  npx web-push generate-vapid-keys
# The private key is a secret (keep it in deploy/ansible/.secrets.yml); the
# public key is served to the web app. Subject defaults to APP_URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Who may create groups: open | allowlist | admins
GROUP_CREATION=admins
# Comma-separated emails (used when GROUP_CREATION=allowlist).
GROUP_CREATION_ALLOWLIST=
# Comma-separated emails of instance admins. They get a read-only admin view
# (all groups / editions / users — never draws) and can delete any group.
INSTANCE_ADMINS=

# Branding / defaults.
INSTANCE_NAME=Santa
DEFAULT_LANGUAGE=en

# Path to a markdown file replacing the built-in privacy text (optional).
PRIVACY_PAGE_PATH=

# Years without activity before a group is auto-deleted.
INACTIVE_GROUP_YEARS=3

# Read the client IP from proxy headers (set true behind a reverse proxy).
TRUST_PROXY=false

# HTTP port the server listens on.
PORT=3000

# ─── Rate limit overrides (optional) ──────────────────────────────────────
# RATE_LIMIT_SIGNIN_PER_EMAIL=5
# RATE_LIMIT_SIGNIN_PER_IP=20
# RATE_LIMIT_CODE_ATTEMPTS=5
# RATE_LIMIT_GROUPS_PER_ACCOUNT=3
# RATE_LIMIT_INVITES_PER_ACCOUNT=50
# RATE_LIMIT_RESENDS_PER_PARTICIPANT=1
# RATE_LIMIT_MESSAGES_PER_PARTICIPANT=20
# RATE_LIMIT_MEMBERS_PER_GROUP=50

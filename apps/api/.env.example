# Local development env for the API. Copy to apps/api/.env and fill ENCRYPTION_KEY.
#   cp apps/api/.env.example apps/api/.env
# apps/api/.env is git-ignored. See README "Develop locally".

# Public URL of the app. In dev the web runs on Vite (:5173) and proxies /api.
APP_URL=http://localhost:5173
PORT=3000

# Matches docker-compose.dev.yml (postgres service).
DATABASE_URL=postgres://santa:santa@localhost:5432/santa

# 32 random bytes, base64. Generate once and keep it stable for this DB:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Dev conveniences: let anyone create a group, and make yourself an instance admin.
GROUP_CREATION=open
INSTANCE_ADMINS=you@example.com
DEFAULT_LANGUAGE=en

# Email: leave SMTP unset for log-only mode (the sign-in code prints to the API
# console). To use the Mailpit container instead (UI at http://localhost:8025):
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# MAIL_FROM=Santa <santa@localhost>

# Web Push (optional). Generate once: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
